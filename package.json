{
  "name": "birthdaymanu",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:notify": "node --test scripts/notify.test.mjs",
    "test:all": "npm test && npm run test:notify",
    "notify": "node --env-file-if-exists=.env.local scripts/notify.mjs",
    "notify:dry-run": "node --env-file-if-exists=.env.local scripts/notify.mjs --dry-run",
    "configure:backend": "node --env-file-if-exists=.env.local scripts/configure-backend.mjs",
    "lint": "eslint ."
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "nodemailer": "^10.5.0",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^20.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
