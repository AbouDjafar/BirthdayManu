# Copier en .env.local et renseigner les deux valeurs publiques.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hébergement Vercel : adresse publique de production, utilisée aussi en preview.
VITE_BASE_PATH=/
VITE_PUBLIC_SITE_URL=https://birthdaymanu.vercel.app/

# Uniquement pour reconfigurer les contenus depuis un script local. Jamais VITE_.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
